# ── Pulse41 Environment Variables ───────────────────────────────────────
# Copy this file to .env.local for local development.
# For production deployment on Vercel, configure these in the Vercel Dashboard:
# Project Settings -> Environment Variables

# Supabase Public API Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Service Role Key (NEVER expose to the client)
# Found in: Supabase Dashboard -> Project Settings -> API (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Canonical Site URL (used for absolute URLs in OG tags and sitemaps)
NEXT_PUBLIC_SITE_URL=https://pulse41.com
